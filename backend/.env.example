# Allowed CORS origin once deployed (API Gateway / Lambda). The local dev server
# always answers with "*", and the frontend calls it through the Vite proxy anyway.
# FRONT_END_URL=https://vacations.example.com

# PostgreSQL — matches docker-compose.yml in the repository root
DB_HOST=localhost
DB_PORT=5433
DB_USER=vacation
DB_PASSWORD=vacation
DB_NAME=vacation

# Auth — use a long random secret outside local development
JWT_SECRET=local-dev-secret-change-me
JWT_EXPIRES_IN=8h
