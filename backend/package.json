{
  "name": "vacation-management-backend",
  "version": "1.0.0",
  "description": "Vacation management API on the Common Event Framework",
  "type": "commonjs",
  "scripts": {
    "codegen": "node node_modules/commoneventframework/dist/script/generateHandlerRegistry.js",
    "dev": "npx ts-node src/index.ts --local",
    "build": "cef-build",
    "build:full": "cef-build --full",
    "typecheck": "tsc --noEmit",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/database/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/database/data-source.ts",
    "migration:show": "typeorm-ts-node-commonjs migration:show -d src/database/data-source.ts",
    "seed": "ts-node src/database/seed.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "commoneventframework": "^1.0.19",
    "dotenv": "^16.6.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "pino-pretty": "^13.2.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.12"
  },
  "private": true
}
